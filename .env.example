# YouCam API (https://yce.makeupar.com/api-console/en/api-keys/). Leave empty to run in mock mode.
YOUCAM_API_KEY=
# Secret key from the same console page (shown once). Only needed for the V1 credit/balance endpoint; V2 task calls use the API key alone.
YOUCAM_SECRET_KEY=
# mock | live. Defaults to mock when YOUCAM_API_KEY is empty.
YOUCAM_MODE=mock
# Anthropic API key for /api/grade (Claude vision). Empty = deterministic local grader.
ANTHROPIC_API_KEY=
# Grader model id (default claude-opus-5-5)
GRADER_MODEL=claude-opus-5-5

# Unit guard (F8)
SESSION_UNIT_CAP=20
DAILY_UNIT_CAP=120
DEMO_MODE_THRESHOLD=150
# Mock-mode starting balance (only used when YOUCAM_MODE=mock)
MOCK_CREDIT=1000

# Spike scripts (scripts/spike/run.ts)
SPIKE_MAX_UNITS=55
SPIKE_FACE_IMAGE=.local/face.jpg
SPIKE_FACE_RUNS=3
SPIKE_VTO_MODE=
